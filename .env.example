# Gemini
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
# Optional: rotate across many keys. Comma, semicolon, or whitespace separated.
# Topic classifier uses GOOGLE_API_KEY or GOOGLE_API_KEYS.
GOOGLE_API_KEYS=
MODEL_NAME=gemini-3.1-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-2
LLM_TEMPERATURE=0.01
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro
COHERE_RERANK_CANDIDATE_LIMIT=40
COHERE_RERANK_MAX_TOKENS_PER_DOC=2048

# Guardrail safeguard provider. Default is Groq, so no OpenAI API key is required.
OPENAI_SAFEGUARD_ENABLED=true
SAFEGUARD_PROVIDER=groq
GROQ_API_KEY=
# Optional: rotate across many Groq keys. Comma, semicolon, or whitespace separated.
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# Optional fallback only when SAFEGUARD_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_SAFEGUARD_MODEL=gpt-5-mini
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=
# Logging
LOG_LEVEL=INFO
APP_NAME=HR Helpdesk AI
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CHAT_RATE_LIMIT_COUNT=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_MODE=block
GUARDRAILS_FAIL_CLOSED=true
TOPIC_CLASSIFIER_ENABLED=true
TOPIC_CLASSIFIER_PROVIDER=gemma
TOPIC_CLASSIFIER_MODEL=gemma-4-12b-it
TOPIC_CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
OUTPUT_GUARDRAIL_ENABLED=true
TOOL_GUARDRAIL_ENABLED=true
GUARDRAIL_LOG_DECISIONS=true
GUARDRAIL_LOG_RAW_TEXT=false

# AI Hook Logging (optional)
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# Monitor
LANGFUSE_SECRET_KEY="sk-"
LANGFUSE_PUBLIC_KEY="pk-"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

